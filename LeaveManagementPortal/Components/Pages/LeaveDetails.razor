@page "/leaves/{id:int}"


@rendermode InteractiveServer

@inject LeaveService LeaveService
@inject NavigationManager NavigationManager


<div class="leave-details-page">

    @if (leave == null)
    {
        <div class="loading">
            <p>Loading leave details...</p>
        </div>
    }
    else
    {
        <!-- Back -->
        <button class="back-button" @onclick="GoBack">
            ← Back to Leave Requests
        </button>

        <!-- Header -->
        <div class="details-header">

            <div>
                <h2>Leave Details</h2>
                <p>View complete information about this leave request</p>
            </div>
        </div>


        <!-- Employee Card -->
        <div class="employee-card">

            <div class="employee-avatar">
                @GetInitials(leave.EmployeeName)
            </div>

            <div class="employee-info">
                <h3>@leave.EmployeeName</h3>
                <p>Employee Leave Request</p>
            </div>

        </div>


        <!-- Leave Information -->
        <div class="section-title">
            <h3>Leave Information</h3>
        </div>

        <div class="info-grid">

            <div class="info-card">
                <span class="info-label">Leave Type</span>
                <span class="info-value">@leave.LeaveType</span>
            </div>

            <div class="info-card">
                <span class="info-label">Status</span>

                <span class="status-badge @GetStatusClass(leave.Status)">
                    @leave.Status
                </span>
            </div>

            <div class="info-card">
                <span class="info-label">Start Date</span>
                <span class="info-value">
                    @leave.StartDate?.ToString("dd MMM yyyy")
                </span>
            </div>

            <div class="info-card">
                <span class="info-label">End Date</span>
                <span class="info-value">
                    @leave.EndDate?.ToString("dd MMM yyyy")
                </span>
            </div>

            <div class="info-card">
                <span class="info-label">Created Date</span>
                <span class="info-value">
                    @leave.CreatedDate.ToString("dd MMM yyyy")
                </span>
            </div>

        </div>


        <!-- Reason -->
        <div class="section-title">
            <h3>Reason</h3>
        </div>

        <div class="reason-card">
            <p>@leave.Reason</p>
        </div>


        <!-- Actions -->
        <div class="details-actions">

            <button class="secondary-button"
                    @onclick="GoBack">
                Close
            </button>

        </div>

    }
</div>


@code
{
    [Parameter]
    public int id { get; set; }

    private LeaveRequest? leave;


    protected override async Task OnInitializedAsync()
    {
        leave = await LeaveService.GetByIdAsync(id);
    }


    private void GoBack()
    {
        NavigationManager.NavigateTo("/leaves");
    }


    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 1)
            return parts[0][0].ToString().ToUpper();

        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }


    private string GetStatusClass(LeaveStatus status)
    {
        return status switch
        {
            LeaveStatus.Approved => "status-approved",
            LeaveStatus.Rejected => "status-rejected",
            LeaveStatus.Pending => "status-pending",
            _ => "status-default"
        };
    }
}