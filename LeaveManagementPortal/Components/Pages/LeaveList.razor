@page "/leaves"
@rendermode InteractiveServer

@inject NavigationManager NavigationManager
@inject LeaveService LeaveService

<div class="leaves-page">

    <!-- ================= PAGE HEADER ================= -->

    <div class="leaves-header">

        <div class="header-content">
            <span class="page-eyebrow">LEAVE MANAGEMENT</span>

            <h1>Leave Requests</h1>

            <p>
                View, track and manage employee leave requests.
            </p>
        </div>

        <SfButton CssClass="apply-leave-btn"
                  @onclick="ApplyLeave">
            <span>＋</span>
            Apply for Leave
        </SfButton>

    </div>


    <!-- ================= SUMMARY CARDS ================= -->
    @if (leaves != null)
    {
        <div class="leave-summary">

            <div class="summary-card total">
                <div class="summary-icon">
                    📋
                </div>

                <div>
                    <span>Total Requests</span>
                    <h3>@leaves.Count</h3>
                </div>
            </div>


            <div class="summary-card pending">
                <div class="summary-icon">
                    ⏳
                </div>

                <div>
                    <span>Pending</span>
                    <h3>@leaves.Count(x => x.Status == "Pending")</h3>
                </div>
            </div>


            <div class="summary-card approved">
                <div class="summary-icon">
                    ✓
                </div>

                <div>
                    <span>Approved</span>
                    <h3>@leaves.Count(x => x.Status == "Approved")</h3>
                </div>
            </div>


            <div class="summary-card rejected">
                <div class="summary-icon">
                    ✕
                </div>

                <div>
                    <span>Rejected</span>
                    <h3>@leaves.Count(x => x.Status == "Rejected")</h3>
                </div>
            </div>

        </div>
    }


    <!-- ================= FILTER ================= -->

    <div class="filter-card">

        <div class="filter-header">

            <div>
                <h4>Filter Requests</h4>
                <p>Filter leave requests based on their current status.</p>
            </div>

        </div>


        <div class="filter-content">

            <div class="status-filter">

                <label>Leave Status</label>

                <SfDropDownList TValue="string"
                                TItem="string"
                                DataSource="@statusOptions"
                                @bind-Value="selectedStatus"
                                Placeholder="All Statuses"
                                CssClass="status-dropdown">
                </SfDropDownList>

            </div>


            <div class="filter-actions">

                <SfButton CssClass="filter-btn"
                          OnClick="ApplyFilter">
                    Filter
                </SfButton>


                @if (!string.IsNullOrEmpty(selectedStatus))
                {
                    <SfButton CssClass="clear-btn"
                              @onclick="ClearFilter">
                        Clear
                    </SfButton>
                }

            </div>

        </div>

    </div>


    <!-- ================= CONTENT ================= -->
    @if (leaves == null)
    {
        <div class="loading-state">

            <div class="loading-spinner"></div>

            <h4>Loading leave requests...</h4>

            <p>Please wait while we retrieve the information.</p>

        </div>
    }
    else if (leaves.Count == 0)
    {
        <div class="empty-state">

            <div class="empty-icon">
                📭
            </div>

            <h3>No Leave Requests Found</h3>

            <p>
                There are currently no leave requests matching your filter.
            </p>

            <SfButton CssClass="apply-leave-btn"
                      @onclick="ApplyLeave">
                + Apply for Leave
            </SfButton>

        </div>
    }
    else
    {
        <div class="requests-header">

            <div>
                <h3>Leave Requests</h3>

                <span>
                    Showing @leaves.Count request(s)
                </span>
            </div>

        </div>


        <div class="leave-grid">

            @foreach (var leave in leaves)
            {
                <LeaveCard Leave="leave"
                           OnView="ViewDetails"
                           OnStatusChange="status =>
                           HandleStatusChange(leave.Id, status)" />
            }

        </div>
    }

</div>


@code
{
    private List<LeaveRequest>? leaves;

    private List<string> statusOptions = new()
    {
        "Pending",
        "Approved",
        "Rejected"
    };

    private string? selectedStatus;


    [SupplyParameterFromQuery(Name = "status")]
    public string? Status { get; set; }


    protected override async Task OnParametersSetAsync()
    {
        var allLeaves = await LeaveService.GetAllAsync();

        selectedStatus = Status;

        if (string.IsNullOrEmpty(Status))
        {
            leaves = allLeaves;
        }
        else
        {
            leaves = allLeaves
                .Where(x => x.Status == Status)
                .ToList();
        }
    }


    private void ApplyFilter()
    {
        if (string.IsNullOrEmpty(selectedStatus))
        {
            NavigationManager.NavigateTo("/leaves");
        }
        else
        {
            NavigationManager.NavigateTo(
                $"/leaves?status={Uri.EscapeDataString(selectedStatus)}");
        }
    }


    private void ClearFilter()
    {
        selectedStatus = null;

        NavigationManager.NavigateTo("/leaves");
    }


    private void ViewDetails(int id)
    {
        NavigationManager.NavigateTo($"/leaves/{id}");
    }


    private async Task HandleStatusChange(int id, string status)
    {
        await LeaveService.UpdateStatusAsync(id, status);

        await OnParametersSetAsync();
    }


    private void ApplyLeave()
    {
        NavigationManager.NavigateTo("/leaves/create");
    }
}